<!-- Vector versions of the app logo, converted from Assets/icon.svg (LogoImage) and Assets/icon-small.svg
     (LogoSmallImage, for 16-32 px). Vectors stay sharp at every size and display scaling.
     The transparent 256x256 rectangle in each drawing keeps the SVG's square bounds. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
                <!-- soft shadow under the shield -->
                <GeometryDrawing Brush="#1F0B2545" Geometry="M128,20 C160,38 192,44 220,44 V122 C220,180 182,222 128,244 C74,222 36,180 36,122 V44 C64,44 96,38 128,20 Z" />
                <!-- shield -->
                <GeometryDrawing Geometry="M128,16 C160,34 192,40 220,40 V118 C220,176 182,218 128,240 C74,218 36,176 36,118 V40 C64,40 96,34 128,16 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#3AA0F3" />
                            <GradientStop Offset="1" Color="#0B4FA0" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M128,30 C156,45 184,51 208,52 V118 C208,168 176,204 128,225">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#40FFFFFF" Thickness="3" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- toggles: on, off, on -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="72,72,64,30" RadiusX="15" RadiusY="15" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0F6CBD">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="121,87" RadiusX="10" RadiusY="10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#BFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="140,82,44,10" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="4" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="72,114,64,30" RadiusX="15" RadiusY="15" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="87,129" RadiusX="9" RadiusY="9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#BFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="140,124,32,10" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="72,156,64,30" RadiusX="15" RadiusY="15" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0F6CBD">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="121,171" RadiusX="10" RadiusY="10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- export badge with a soft shadow -->
                <GeometryDrawing Brush="#260B2545">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="196,200" RadiusX="48" RadiusY="48" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#3CC46B" />
                            <GradientStop Offset="1" Color="#0E8A3A" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="6" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="196,196" RadiusX="44" RadiusY="44" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M176,196 H212 M198,182 L212,196 L198,210">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="9" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="LogoSmallImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
                <GeometryDrawing Geometry="M120,8 C156,28 192,34 224,34 V116 C224,178 182,224 120,248 C58,224 16,178 16,116 V34 C48,34 84,28 120,8 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#2B95EE" />
                            <GradientStop Offset="1" Color="#0B4FA0" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- on -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="44,62,112,52" RadiusX="26" RadiusY="26" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0B5CB0">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="130,88" RadiusX="18" RadiusY="18" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- off -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="12" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="50,134,100,44" RadiusX="22" RadiusY="22" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="72,156" RadiusX="13" RadiusY="13" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- export badge -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#2DB85C" />
                            <GradientStop Offset="1" Color="#0E8A3A" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="10" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="194,194" RadiusX="56" RadiusY="56" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M166,194 H218 M198,173 L219,194 L198,215">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FFFFFF" Thickness="15" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
