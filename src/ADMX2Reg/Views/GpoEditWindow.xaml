<ui:FluentWindow x:Class="ADMX2Reg.Views.GpoEditWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="480" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" Grid.Row="0" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="24,12,24,20">
            <TextBlock Text="Name" Margin="0,0,0,4" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="Group Policy Object name" />
            <TextBlock Text="Description" Margin="0,14,0,4" />
            <ui:TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                        VerticalContentAlignment="Top" PlaceholderText="Optional description" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="OK" Appearance="Primary" MinWidth="90" IsDefault="True" Click="Ok_Click" />
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
