<ui:FluentWindow x:Class="ADMX2Reg.Views.ImportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:ADMX2Reg.Controls"
                 Width="620" Height="580" MinWidth="460" MinHeight="460"
                 Title="Import" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Import" ShowMinimize="False" ShowMaximize="False" />
        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" />

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Import into" FontWeight="SemiBold" />
                    <c:HelpTip Text="Each registry value is mapped back to the policy that writes it, including its options. Values that match no policy are kept as Extra Registry Settings, so nothing is lost.&#10;&#10;Merge: imported policies overwrite the same policies in the selected GPO. Its other settings stay as they are." />
                </StackPanel>
                <RadioButton x:Name="NewRadio" GroupName="Target" Content="New GPO" IsChecked="True" />
                <ui:TextBox x:Name="NameBox" Margin="28,2,0,6" PlaceholderText="GPO name" />
                <RadioButton x:Name="MergeRadio" GroupName="Target" />
            </StackPanel>

            <TextBlock x:Name="WarningsHeader" Grid.Row="2" Text="Warnings" FontWeight="SemiBold" Margin="0,16,0,6" />
            <ListBox x:Name="WarningsList" Grid.Row="3">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Import" Appearance="Primary" MinWidth="90" IsDefault="True" Click="Ok_Click" />
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
