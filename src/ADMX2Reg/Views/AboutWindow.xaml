<ui:FluentWindow x:Class="ADMX2Reg.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="About ADMX2Reg" Width="460" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="About ADMX2Reg" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="28,8,28,24">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource LogoImage}" Width="64" Height="64" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ADMX2Reg" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap"
                       Text="Portable Group Policy editor that exports ADMX-based settings as .reg, PowerShell or Registry.pol, without applying them to the machine." />

            <TextBlock Margin="0,20,0,0" Text="John Billekens Consultancy" FontWeight="SemiBold" />
            <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Free and open source under the MIT License." />

            <StackPanel Margin="0,16,0,0">
                <TextBlock>
                    <Hyperlink NavigateUri="https://github.com/j81blog/ADMX2Reg" RequestNavigate="Link_RequestNavigate">github.com/j81blog/ADMX2Reg</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://github.com/j81blog/ADMX2Reg/blob/main/LICENSE" RequestNavigate="Link_RequestNavigate">License</Hyperlink>
                    <Run Text="  ·  " />
                    <Hyperlink NavigateUri="https://github.com/j81blog/ADMX2Reg/blob/main/THIRD-PARTY-NOTICES.md" RequestNavigate="Link_RequestNavigate">Third-party notices</Hyperlink>
                </TextBlock>
            </StackPanel>

            <ui:Button Content="OK" Appearance="Primary" MinWidth="90" HorizontalAlignment="Right" Margin="0,24,0,0"
                       IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
