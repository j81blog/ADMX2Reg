<ui:FluentWindow x:Class="ADMX2Reg.Views.PolicyEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:ADMX2Reg.Controls"
                 Width="980" Height="720" MinWidth="760" MinHeight="520"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" Grid.Row="0" ShowMinimize="False" ShowMaximize="False" />
        <Grid Grid.Row="1" Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <ui:Button x:Name="PrevButton" Icon="{ui:SymbolIcon ArrowLeft24}" Content="Previous Setting" Click="Prev_Click" />
                    <ui:Button x:Name="NextButton" Icon="{ui:SymbolIcon ArrowRight24}" Content="Next Setting" Margin="8,0,0,0" Click="Next_Click" />
                </StackPanel>
            </Grid>

            <!-- body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="300" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <RadioButton x:Name="NotConfiguredRadio" GroupName="State" Content="Not Configured" Checked="State_Checked" />
                        <RadioButton x:Name="EnabledRadio" GroupName="State" Content="Enabled" Checked="State_Checked" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DisabledRadio" GroupName="State" Content="Disabled" Checked="State_Checked" />
                            <c:HelpTip Text="Not Configured: this GPO writes nothing for the policy.&#10;&#10;Enabled: writes the policy value and the options below.&#10;&#10;Disabled: writes the disabled value when the ADMX file defines one, otherwise it removes the value. The values of the options are removed too.&#10;&#10;This is the same as what the Group Policy engine does." />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="Comment" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="CommentBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                    VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="Comment_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,10,0,10">
                        <TextBlock Text="Supported on" FontWeight="SemiBold" />
                        <TextBlock x:Name="SupportedText" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Row="3" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Options" FontWeight="SemiBold" Margin="12,8,12,4" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,4,12,12">
                                <StackPanel x:Name="OptionsPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Help" FontWeight="SemiBold" Margin="12,8,12,4" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,4,12,12">
                            <TextBlock x:Name="HelpText" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="OK" Appearance="Primary" MinWidth="90" IsDefault="True" Click="Ok_Click" />
                <ui:Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
                <ui:Button x:Name="ApplyButton" Content="Apply" MinWidth="90" Margin="8,0,0,0" Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
